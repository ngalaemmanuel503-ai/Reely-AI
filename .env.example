# GEMINI_API_KEY: Required for Gemini AI API calls on the server.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PAYMENT_PROVIDER: 'mock' for local development; 'futura' when live Futura Pay credentials are configured.
PAYMENT_PROVIDER="mock"

# WHATSAPP_SUPPORT_URL: Optional support link displayed in Help and Footer.
WHATSAPP_SUPPORT_URL="https://wa.me/237600000000"

# ADMIN_PASSCODE: Optional server-side passcode for claiming or unlocking the Admin console.
ADMIN_PASSCODE=""
